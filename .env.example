# Copy to .env and fill in. The project .env wins over inherited shell env.

# Option A — Anthropic (default): just set the key, leave the rest unset
# ANTHROPIC_API_KEY=sk-ant-...

# Option B — any Anthropic-compatible API (e.g. z.ai GLM Coding Plan):
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# ANTHROPIC_AUTH_TOKEN=your-token-here
# FORGECADE_MODEL=glm-5.2

# Option C — the local Codex CLI. Its ChatGPT login spends your subscription
# allowance instead of API credits, so no key lives here. Requires `codex` on
# PATH and a completed `codex login`. Note this trades streaming for a single
# finished message: the forge progress bar is extrapolated, not measured.
# FORGECADE_PROVIDER=codex
# FORGECADE_MODEL=gpt-5.6-sol
# FORGECADE_REASONING_EFFORT=high        # none|low|medium|high|xhigh|max
# FORGECADE_CODEX_BIN=codex              # absolute path if not on PATH
# FORGECADE_CODEX_HOME=/opt/forgecade/.codex-home   # dir holding auth.json

# Optional server settings:
# FORGECADE_PORT=4242
# FORGECADE_HOST=127.0.0.1
# FORGECADE_ACCESS_CODE=              # set on a public instance: room creation
                                      # then needs /?access=<code>. Joining with
                                      # a room code stays open, so friends need
                                      # nothing extra.
# FORGECADE_MAX_FORGES_PER_DAY=       # hard ceiling on generations per day.
                                      # MAX_FORGES only caps concurrency — this
                                      # is what stops one visitor burning the
                                      # whole allowance. 0/unset = no limit.
# FORGECADE_FORGE_TIMEOUT_MS=         # default 360s (anthropic) / 900s (codex)

# Quality gate — forge several games at once and ship the one that plays.
# Each candidate is played in headless Chrome before it reaches the party.
# FORGECADE_CANDIDATES=3              # 1 = off (default)
# FORGECADE_SMOKE_TEST=0              # disable the browser check entirely
# FORGECADE_SMOKE_PLAYERS=8           # judge at a full room (default 8)
# FORGECADE_SMOKE_SECONDS=180         # a round must resolve within this
# FORGECADE_CHROME=                   # path, if Chrome is somewhere unusual
